<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="register.css">
    </head>
    <body>
        <h1 id="head">File view</h1>
        <h2>File name: <%= file.name %></h2>
        <h2>File type: <%= file.mimeType %></h2>
        <h2>Uploaded at: <%= file.addedAt %></h2>
        <a href="/file/download/<%= file.id %>">
            <button>Download</button>
        </a>
        <a href="/">
            <button>Go Home</button>
        </a>
    </body>
</html>