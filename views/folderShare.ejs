<!DOCTYPE html>
<html>
    <head>
        <link rel="stylesheet" href="/register.css">
        <link rel="stylesheet" href="/index.css">
    </head>
    <body>
        <h1 id="head">Shared folder</h1>
        <h3>Expires : <%= expires %></h3>
        <div class="folder shared">
            <div class="folder-details">
                <h3><%= folderName %></h3>
            </div> 
            <% if (typeof files !== 'undefined' || files) { %>
                <% files.forEach( file => { %>
                    <div class="file-container">
                        <div class="file">
                            <%= file.name %>
                            <a href="<%= file.url %>" class="button-link" >download</a>
                        </div>
                    </div>
                <% }) %>
            <% } %>
            
        </div>
        <a href="/">
            <button>Go Home</button>
        </a>
    </body>
</html>