<!DOCTYPE html>
<html>
    <head></head>
    <body>

        <% if (typeof alerts !== 'undefined' && alerts) { %>
            <div class="alerts-container">
                <ul>
                    <% alerts.forEach ( alert  => { %>
                        <li> <%= alert %> </li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (typeof logged !== 'undefined' && logged) { %>
            <p>you are logged!!!!</p>
            <p>and user is <%= user.username %></p>
            <a href="/folder">Create a folder</a>
            <a href="/upload">upload file</a>
            <form action="/logout" method="POST">
                <button type="submit">Logout ?</button>
            </form>

            <div class="folder-container">
                <% if (typeof folders !== 'undefined' && folders) { %>
                    <% folders.forEach(folder => { %>
                        <div class="folder">

                            <%= folder.name %>

                            <a href="/upload?folderId=<%= folder.id %>">upload file</a>

                            <form action="/folder/delete/<%= folder.id %>" method="post">
                                <button type="submit">delete folder</button>
                            </form>

                            <div class="file-container">
                                <% folder.file.forEach(file => { %>
                                    <div class="file">
                                        <%= file.name %>
                                        <form action="/folder/<%= file.id %>/delete" method="post">
                                            <button type="submit">delete file</button>
                                        </form>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
            

        <% } else { %>
            <p>you are not logged (sad)</p>
            <a href="/register">register</a>
            <a href="/login">Login</a>
        <% } %>

        <h1>This is Home</h1>
    </body>
</html>